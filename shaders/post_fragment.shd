#version 410
in vec2 uv;
uniform sampler2D scene_tex;
uniform mat4 view;
uniform mat4 proj;
uniform vec3 sun_dir;
uniform vec3 sun_color;
out vec4 output_color;

const int   NUM_SAMPLES = 100;
const float DENSITY  = 0.85;  // longueur des rayons (0..1)
const float DECAY    = 0.95;  // attenuation par pas
const float WEIGHT   = 0.35;  // rayons plus subtils
const float EXPOSURE = 0.12;  // intensite globale (god rays plus faibles)

const float EDGE_THRESHOLD = 0.28; // sensibilite du contour (bas = plus de lignes)
const float EDGE_STRENGTH  = 1.0;  // contours franchement noirs

// Luminance ponderee, robuste pour detecter les bords de feuillage.
float luma(vec2 c) {
    return dot(texture(scene_tex, c).rgb, vec3(0.299, 0.587, 0.114));
}

// Magnitude du gradient de Sobel 3x3 autour de uv.
float sobel(vec2 uv, vec2 texel) {
    float tl = luma(uv + texel * vec2(-1.0,  1.0));
    float t  = luma(uv + texel * vec2( 0.0,  1.0));
    float tr = luma(uv + texel * vec2( 1.0,  1.0));
    float l  = luma(uv + texel * vec2(-1.0,  0.0));
    float r  = luma(uv + texel * vec2( 1.0,  0.0));
    float bl = luma(uv + texel * vec2(-1.0, -1.0));
    float b  = luma(uv + texel * vec2( 0.0, -1.0));
    float br = luma(uv + texel * vec2( 1.0, -1.0));

    float gx = -tl - 2.0 * l - bl + tr + 2.0 * r + br;
    float gy = -tl - 2.0 * t - tr + bl + 2.0 * b + br;
    return length(vec2(gx, gy));
}

void main() {
    vec3 scene = texture(scene_tex, uv).rgb;
    vec3 rays  = vec3(0.0);

    // Position du soleil en espace ecran (directionnel -> w = 0).
    vec4 sclip = proj * view * vec4(sun_dir, 0.0);
    if (sclip.w > 0.0) {                       // soleil devant la camera
        vec2 sun_uv = (sclip.xy / sclip.w) * 0.5 + 0.5;
        vec2 delta  = (uv - sun_uv) * (DENSITY / float(NUM_SAMPLES));
        vec2 coord  = uv;
        float illum = 1.0;
        for (int i = 0; i < NUM_SAMPLES; ++i) {
            coord -= delta;
            vec3 s = texture(scene_tex, coord).rgb;
            // On ne garde que ce qui depasse 1.0 (le disque solaire HDR).
            float bright = max(0.0, max(max(s.r, s.g), s.b) - 1.0);
            rays  += s * bright * illum * WEIGHT;
            illum *= DECAY;
        }
        rays *= EXPOSURE;
    }

    vec3 c = scene + rays * sun_color;

    // Contour Sobel : trace des lignes noires sur tous les bords (cartoon).
    // On echantillonne sur 2 texels pour des lignes plus epaisses et continues.
    vec2 texel = 2.0 / vec2(textureSize(scene_tex, 0));
    float edge = smoothstep(EDGE_THRESHOLD, EDGE_THRESHOLD + 0.25, sobel(uv, texel));
    c = mix(c, vec3(0.0), edge * EDGE_STRENGTH);

    // Grading crepusculaire : pousse les chauds, refroidit les ombres.
    c *= vec3(1.12, 0.95, 0.82);
    c = mix(c, c * vec3(0.7, 0.78, 1.05), smoothstep(0.5, 0.0, dot(c, vec3(0.333))));

    // Vignette chaude pour resserrer l'ambiance.
    vec2 d = uv - 0.5;
    float vig = smoothstep(0.85, 0.25, dot(d, d) * 2.0);
    c *= mix(vec3(0.55, 0.35, 0.30), vec3(1.0), vig);

    c = pow(c, vec3(1.0 / 1.7  ));   // gamma
    output_color = vec4(c, 1.0);
}
