#version 410
in vec2 ndc;

uniform mat4 inv_view_proj;
uniform vec3 cam_pos;
uniform vec3 sun_dir;
uniform float time;

uniform vec3 zenith_color = vec3(0.18, 0.20, 0.42);
uniform vec3 horizon_color = vec3(0.95, 0.45, 0.25);

uniform bool clouds_enabled = true;
uniform float cloud_height = 50.0;
uniform float cloud_scale = 0.012;
uniform vec2 cloud_speed = vec2(0.035, 0.014);
uniform float cloud_cover_low = 0.38;
uniform float cloud_cover_high = 0.65;
uniform float cloud_opacity = 0.95;
uniform vec3 cloud_shadow_color = vec3(0.28, 0.22, 0.40);
uniform vec3 cloud_lit_color = vec3(1.0, 0.62, 0.42);

out vec4 output_color;

float hash(vec2 p) {
    return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
}

float noise(vec2 p) {
    vec2 i = floor(p);
    vec2 f = fract(p);
    vec2 u = f * f * (3.0 - 2.0 * f);
    return mix(mix(hash(i), hash(i + vec2(1.0, 0.0)), u.x),
               mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), u.x),
               u.y);
}

float fbm(vec2 p) {
    float v = 0.0;
    float a = 0.5;
    for (int i = 0; i < 5; i++) {
        v += a * noise(p);
        p = p * 2.03 + vec2(13.7, 9.1);
        a *= 0.5;
    }
    return v;
}

void main() {
    vec4 world = inv_view_proj * vec4(ndc, 1.0, 1.0);
    vec3 ray_dir = normalize(world.xyz / world.w - cam_pos);

    float h = clamp(ray_dir.y * 0.5 + 0.5, 0.0, 1.0);
    vec3 sky = mix(horizon_color, zenith_color, smoothstep(0.45, 0.85, h));

    float sun_dot = max(dot(ray_dir, sun_dir), 0.0);
    sky += pow(sun_dot, 6.0)  * vec3(1.0, 0.55, 0.25) * 0.55;
    sky += pow(sun_dot, 40.0) * vec3(1.0, 0.7, 0.4)  * 0.8;

    float disc = smoothstep(0.9965, 0.9990, sun_dot);
    sky = mix(sky, vec3(1.0, 0.78, 0.5), disc);
    sky += disc * vec3(1.0, 0.6, 0.35) * 1.4;

    if (clouds_enabled && ray_dir.y > 0.01) {
        float t = (cloud_height - cam_pos.y) / ray_dir.y;
        vec2 uv = (cam_pos.xz + ray_dir.xz * t) * cloud_scale;
        uv += time * cloud_speed;

        float density = fbm(uv);
        density = smoothstep(cloud_cover_low, cloud_cover_high, density);

        float horizon_fade = smoothstep(0.02, 0.12, ray_dir.y);
        density *= horizon_fade;

        float lit = pow(sun_dot, 3.0);
        vec3 cloud_color = mix(cloud_shadow_color, cloud_lit_color,
                               lit * 0.8 + 0.15);

        sky = mix(sky, cloud_color, density * cloud_opacity);
    }

    output_color = vec4(sky, 1.0);
}
