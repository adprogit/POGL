#version 410

uniform vec3 sun_dir;
uniform vec3 sun_color;

out vec4 output_color;
in vec3 frag_normal_world;
void main() {
        vec3 N = normalize(frag_normal_world);
       float wrap = 0.5;  // wrap diffuse pour éviter zones noires
       float NdotL = (dot(N, sun_dir) + wrap) / (1.0 + wrap);
       NdotL = max(NdotL, 0.0);

       vec3 base = vec3(0.35, 0.55, 0.20);
       vec3 ambient = vec3(0.25, 0.30, 0.20) * base;
       vec3 diffuse = NdotL * sun_color * base;

       output_color = vec4(ambient + diffuse, 1.0);
}