#version 410

uniform vec3 sun_dir;
uniform vec3 sun_color;

out vec4 output_color;
in vec3 frag_normal_world;
in vec3 frag_pos;

// Bruit pseudo-aleatoire stable pour des taches d'herbe.
float hash(vec2 p) {
    return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
}

void main() {
       vec3 N = normalize(frag_normal_world);
       float wrap = 0.5;  // wrap diffuse pour eviter zones noires
       float NdotL = (dot(N, sun_dir) + wrap) / (1.0 + wrap);
       NdotL = max(NdotL, 0.0);

       // Lumiere discretisee en 3 bandes franches -> effet cartoon.
       float bands = 3.0;
       float toon = floor(NdotL * bands) / (bands - 1.0);
       toon = clamp(toon, 0.0, 1.0);

       // Deux teintes de vert melangees par des taches douces -> sol plus joli.
       vec3 grass_a = vec3(0.32, 0.52, 0.18);
       vec3 grass_b = vec3(0.42, 0.60, 0.24);
       float blotch = smoothstep(0.35, 0.65,
                       hash(floor(frag_pos.xz * 0.25)) * 0.6
                     + hash(floor(frag_pos.xz * 0.9)) * 0.4);
       vec3 base = mix(grass_a, grass_b, blotch);

       vec3 ambient = base * 0.30;
       vec3 diffuse = toon * sun_color * base;

       output_color = vec4(ambient + diffuse, 1.0);
}