#version 410

uniform vec3 sun_dir;
uniform vec3 sun_color;
uniform vec3 ground_color = vec3(0.35, 0.55, 0.20);
uniform vec3 ground_ambient = vec3(0.045, 0.040, 0.05);
uniform float ground_wrap = 0.5;

out vec4 output_color;
in vec3 frag_normal_world;
void main() {
        vec3 N = normalize(frag_normal_world);
       float NdotL = (dot(N, sun_dir) + ground_wrap) / (1.0 + ground_wrap);
       NdotL = max(NdotL, 0.0);

       vec3 ambient = ground_ambient * ground_color;
       vec3 diffuse = NdotL * sun_color * ground_color;

       output_color = vec4(ambient + diffuse, 1.0);
}