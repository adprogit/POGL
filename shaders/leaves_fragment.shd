#version 410

in vec3 frag_position;
in vec3 frag_normal;
in vec2 uv_;

uniform vec3 sun_dir;
uniform vec3 sun_color;
uniform mat4 model_view_matrix;
uniform sampler2D texture_sampler;
uniform sampler2D lighting_sampler;
uniform mat4 view_matrix;

out vec4 output_color;

void main()
{
    vec3 N = normalize(frag_normal);
    vec3 L = normalize(mat3(view_matrix) * sun_dir);

    // Wrap diffuse pour eviter le noir total dans les ombres.
    float wrap  = 0.4;
    float NdotL = max((dot(N, L) + wrap) / (1.0 + wrap), 0.0);

    // La toon-ramp encode deja la couleur de l'objet discretisee en paliers :
    // on l'utilise directement comme albedo (gris pour les rochers, etc.),
    // sans teinte verte codee en dur.
    vec3 ramp = texture(lighting_sampler, vec2(NdotL, 0.5)).rgb;

    // Teinte par la lumiere du soleil, avec un plancher ambiant.
    vec3 lit = ramp * mix(vec3(0.35), sun_color, NdotL);
    output_color = vec4(lit, 1.0);
}